DOMAIN=localhost
PROJECT_NAME=winebar-app
COMPOSE_PROJECT_NAME=winebar-test

# Rutas de archivos
IMAGES_PATH=/app/imagenes
ORDENES_EXPORTADAS_PATH=/app/ordenes_exportadas
TEMPLATES_PATH=/app/sql_app/templates

# Container names
BACKEND_CONTAINER_NAME=${COMPOSE_PROJECT_NAME}_backend
POSTGRES_CONTAINER_NAME=${COMPOSE_PROJECT_NAME}_postgres
PGADMIN_CONTAINER_NAME=${COMPOSE_PROJECT_NAME}_pgadmin
FRONTEND_CONTAINER_NAME=${COMPOSE_PROJECT_NAME}_frontend
NGINX_CONTAINER_NAME=${COMPOSE_PROJECT_NAME}_nginx
SERVIDOR_CLAVES_CONTAINER_NAME=${COMPOSE_PROJECT_NAME}_claves

# Backend
# BACKEND_CORS_ORIGINS=["http://localhost", "http://localhost:4200", "http://localhost:3000", "http://localhost:8080", "https://localhost", "https://localhost:4200", "https://localhost:3000", "https://localhost:8080", "http://dev.altacava.com", "https://stag.altacava.com", "https://altacava.com", "http://local.dockertoolbox.tiangolo.com", "http://localhost.tiangolo.com"]
BACKEND_CORS_ORIGINS=["*"]
## Key for JWT signature
SECRET_KEY=secret-key
SALT=secret-salt
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ACCESS_TOKEN_EXPIRE_MINUTES_LONG=720
TZ=America/Argentina/Buenos_Aires
BACKEND_INTERNAL_PORT=5000

# Frontend
FRONTEND_INTERNAL_PORT=3000

# Servidor de claves (tapero, cajero)
FIRST_SUPERUSER=1234
API_KEY_TERMINAL_CAJA_1=secret-caja
API_KEY_TERMINAL_TAPA_1=secret-tapa
API_KEY_TERMINAL_ADMIN=secret-admin
SERVIDOR_CLAVES_PORT=3001

# Postgres
# POSTGRES_SERVER=${POSTGRES_CONTAINER_NAME} # autoseteado para docker
# POSTGRES_SERVER=localhost # autoseteado para local
POSTGRES_USER=user
POSTGRES_PASSWORD=1234
POSTGRES_DB=db-winebar
POSTGRES_VOLUME=./postgres_data

# PgAdmin
PGADMIN_LISTEN_PORT_EXTERNAL=5050
PGADMIN_LISTEN_PORT_INTERNAL=5050
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin

# Vitte
VITTE_SERVER=Bar
VITTE_USUARIO=UsuarioVitte
VITTE_CLAVE=1234

# Fudo
FUDO_API_KEY=ABCD
FUDO_API_SECRET=secret

# Nginx
NGINX_INTERNAL_PORT=8081
NGINX_EXTERNAL_PORT=80